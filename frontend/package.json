{
  "name": "keychain",
  "version": "0.5.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "lint:check": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "format:check": "vp fmt --check .",
    "format:fix": "vp fmt .",
    "typecheck": "tsc --noEmit --pretty",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "lint:all": "vp fmt . && vp lint --fix . && tsc --noEmit --pretty",
    "preview": "vp preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "axios": "^1.21.1",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.23",
    "js-cookie": "^3.0.5",
    "lodash": "^4.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sass": "^1.108.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/js-cookie": "^3.0.6",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vite-plus": "0.2.6"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.1",
      "onFail": "download"
    }
  }
